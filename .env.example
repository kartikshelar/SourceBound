# Required: GitHub token (public repo read-only) to pull Discussions for the
# eval set, and a Groq key for routing/synthesis/judging.
GITHUB_TOKEN=
GROQ_API_KEY=

# Optional / evaluated-and-rejected providers, kept as documented fallbacks
# (see decisions.md D20, D22). Gemini free tier is 20 req/day; NVIDIA NIM was
# ~159x slower than Groq on the same model.
GEMINI_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
# Optional: Langfuse tracing. Without these the agent runs untraced rather
# than failing. Either LANGFUSE_HOST or LANGFUSE_BASE_URL is accepted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
HF_TOKEN=
